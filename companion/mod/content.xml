<?xml version="1.0" encoding="utf-8"?>
<!-- X4 Companion bridge (v1): streams player, galaxy, sector, property, logbook, missions,
     factions and economy data as JSON lines through the SirNukes named-pipe API to a local
     server (tools\x4companion), and accepts a small allow-listed set of UI commands back.
     UI-only, no game state: save="0" so it can be removed from a save at any time. -->
<content id="x4_companion"
         name="X4 Companion Bridge"
         description="Second-screen browser companion (map, property, logbook, missions, factions) via SirNukes named pipes."
         author="local"
         version="100"
         date="2026-11-14"
         save="0"
         enabled="1">
  <!-- id as declared in extensions\sn_mod_support_apis\content.xml (id="ws_2042901274", version="195") -->
  <dependency id="ws_2042901274" optional="false" name="SirNukes Mod Support APIs" version="195" />
  <!-- optional: in-game hotkeys (extensions\hotkey_api\content.xml id="ws_3750545906", version 80009) -->
  <dependency id="ws_3750545906" optional="true" name="Native Hotkey API" version="80007" />
  <!-- optional: non-error log lines (extensions\lua_log_api\content.xml id="ws_3823580916", version 100) -->
  <dependency id="ws_3823580916" optional="true" name="Lua Log API" version="100" />
</content>
