<?xml version="1.0" encoding="utf-8"?>
<!-- OPTIONAL second tick source for x4_webmap (delete this file to disable it).
     If the UI onUpdate loop stalls while X4 is not the focused window, this cue still
     fires on game time (every 250 ms, not while paused) and pokes the Lua side, which then
     sends a snapshot only if no frame-driven snapshot went out for ~0.5 s.
     Pattern: SirNukes sn_mod_support_apis md\time_api.xml cue "MD_New_Frame" (instantiated,
     no conditions, checkinterval, raise_lua_event) shipped in the installed SN 1.95;
     raise_lua_event itself: vanilla md\cover.xml:397. No variables, no save impact. -->
<mdscript name="X4_WebMap_Tick" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Tick" instantiate="true" checkinterval="250ms">
      <actions>
        <raise_lua_event name="'x4webmap.mdTick'" />
      </actions>
    </cue>
  </cues>
</mdscript>
